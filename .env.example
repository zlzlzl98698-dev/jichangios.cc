# Algolia DocSearch 凭证（仅配置 Search-Only Public API Key，严禁填入 Admin API Key）
# 未设置时站点自动回退到 VitePress Local Search 中文全文检索
VITE_ALGOLIA_APP_ID=
VITE_ALGOLIA_API_KEY=
VITE_ALGOLIA_INDEX_NAME=

# 搜索引擎站长平台 HTML <head> 验证码（构建时直接注入静态源码；未提供时请留空，严禁填入虚构值）
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
VITE_SHENMA_SITE_VERIFICATION=
VITE_BAIDU_SITE_VERIFICATION=
